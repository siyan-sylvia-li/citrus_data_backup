# Files NOT uploaded to Cloud Build when deploying with `gcloud run deploy --source .`
.git
.gitignore
__pycache__/
*.py[cod]
*$py.class
.venv/
venv/
env/
.env
.env.local
.vscode/
.idea/
*.swp
.DS_Store
*.ipynb
app_og.py
# Collected participant data lives in a mounted GCS bucket at runtime,
# never in the build context / image.
recordings/
recordings-local/

# Offline puzzle-design tooling & docs — kept in the repo for reproducibility,
# but never imported at runtime (only engine.py is loaded by the app).
games/othello/solver.py
games/othello/precompute.py
games/othello/generate_puzzles.py
games/othello/import_puzzles.py
games/othello/validate_engine.py
games/othello/motif_analysis.py
games/othello/verify_against_source.py
games/othello/test_othello.py
games/othello/othelloclub_puzzles.txt
games/othello/README.md
games/othello/VERIFY_AGAINST_SOURCE.md
